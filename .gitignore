# Dependencies and local environments
node_modules/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks

# Frontend/backend build output and caches
frontend/dist/
frontend/tsconfig.tsbuildinfo
backend/static/
*.log
*.tmp
*.bak
.DS_Store

# Notebook-generated local state
.ipynb_checkpoints/

